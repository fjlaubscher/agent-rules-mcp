{
  "name": "@fjlaubscher/agent-rules-mcp",
  "version": "0.3.0",
  "description": "MCP server for retrieving and managing Cursor rules and AGENTS.md files",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "agent-rules-mcp": "index.ts"
  },
  "scripts": {
    "start": "node index.ts",
    "test": "vitest run",
    "prettier:check": "prettier --check \"src/**/*\" \"src/*\"",
    "prettier:format": "prettier --write \"src/**/*\" \"src/*\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjlaubscher/agent-rules-mcp.git"
  },
  "files": [
    "index.ts",
    "src/**/*",
    "ts-paths-loader.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "rules",
    "agents",
    "ai",
    "development"
  ],
  "author": {
    "name": "Francois Laubscher",
    "email": "francoisjlaubscher@gmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "minimatch": "^10.0.3"
  },
  "packageManager": "pnpm@10.12.4+sha1.88a0ccfe72d6345dede50dc9d6158400be2420eb"
}
